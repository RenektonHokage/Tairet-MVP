{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tairet:access-core:package-input-manifest:v2",
  "title": "ACCESS_CORE_PACKAGE_INPUT_MANIFEST_V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "package_id",
    "records",
    "artifact_count",
    "runtime_required_count",
    "source_authority_count",
    "production_contact",
    "input_manifest_sha256"
  ],
  "properties": {
    "schema": { "const": "ACCESS_CORE_PACKAGE_INPUT_MANIFEST_V2" },
    "schema_version": { "const": 2 },
    "package_id": { "type": "string", "format": "uuid" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "source_path",
          "package_path",
          "size",
          "sha256",
          "authority_classification",
          "runtime_use",
          "executable",
          "required_at_runtime"
        ],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
          "source_path": { "type": "string", "minLength": 3 },
          "package_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\u0000]+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "authority_classification": { "type": "string", "minLength": 1 },
          "runtime_use": { "type": "string", "minLength": 1 },
          "executable": { "type": "boolean" },
          "required_at_runtime": { "type": "boolean" }
        }
      }
    },
    "artifact_count": { "type": "integer", "minimum": 1 },
    "runtime_required_count": { "type": "integer", "minimum": 1 },
    "source_authority_count": { "type": "integer", "minimum": 1 },
    "production_contact": { "const": 0 },
    "input_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
